# Built website (made by site/build.py, deployed by GitHub Actions)
_site/

# Other people's files (vendor datasheets, drawings, store screenshots): keep them local, never publish
*/reference/

# OpenSCAD and Python scratch files
*.csg
__pycache__/

# Rendered video frames, export logs
*/video/frames/
*/exports/.*.log

# Arduino build output
*/firmware/*/build/
